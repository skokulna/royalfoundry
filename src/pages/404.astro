---
import Base from '../layouts/Base.astro';
import { site, telHref, prettyPhone, waHref } from '../site.config';
import { t, localePath } from '../i18n/ui';
const en = t('en');
const ml = t('ml');
---
<Base lang="en" path="/" title="Page not found — Royal Foundry"
      description="That page could not be found. Royal Foundry, Chingavanam, Kottayam.">
  <section class="nf">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page could not be found.</h1>
      <p class="nf__ml" lang="ml">ആ പേജ് കണ്ടെത്താനായില്ല.</p>
      <p class="nf__sub">
        It may have moved, or the address may be mistyped. Everything we make is
        on the products page.
      </p>
      <div class="nf__btns">
        <a class="btn btn--primary" href={localePath('en', '/products')}>{en.cta.viewProducts}</a>
        <a class="btn btn--ghost" href={localePath('en', '/')}>{en.nav.home}</a>
        <a class="btn btn--wa" href={waHref(en.contact.waMessage)} target="_blank" rel="noopener">
          {en.cta.whatsapp}
        </a>
      </div>
      <p class="nf__ml2" lang="ml">
        <a href={localePath('ml', '/')}>{ml.nav.home}</a> ·
        <a href={localePath('ml', '/products')}>{ml.nav.products}</a>
      </p>
      <p class="nf__call">
        <a href={telHref(site.phonePrimary)}>{prettyPhone(site.phonePrimary)}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(3rem, 2rem + 6vw, 6rem); }
  .nf h1 { max-width: 18ch; margin-bottom: .35rem; }
  .nf__ml { font-size: 1.25rem; color: var(--ink-2); margin-bottom: 1.1rem; }
  .nf__sub { max-width: 52ch; color: var(--ink-2); margin-bottom: 1.75rem; }
  .nf__btns { display: flex; flex-wrap: wrap; gap: .7rem; margin-bottom: 1.75rem; }
  .nf__ml2 { font-size: .95rem; margin-bottom: .4rem; }
  .nf__call a { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
</style>
