{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "royalfoundry",
  "compatibility_date": "2026-08-27",
  // The site is fully static: `npm run build` writes it to dist/, and Cloudflare
  // serves those files straight from its edge network. No server code runs.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
